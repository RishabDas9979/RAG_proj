{
  "name": "Banking Information-Security & Compliance Policy Baseline",
  "version": "1.0",
  "note": "Illustrative baseline written for this project. It is not an official regulatory text and is not legal advice. Replace or extend it with your institution's own obligations.",
  "requirements": [
    {"id": "GOV-01", "title": "Policy ownership, approval and review cycle", "severity": "medium",
     "query": "policy owner approval review cycle annual",
     "any_of": ["policy owner", "approved by", "board approval", "approval of the board", "annual review", "reviewed annually", "reviewed at least", "review cycle"],
     "needs_owner": true, "needs_frequency": true},
    {"id": "ACC-01", "title": "Least-privilege, role-based access", "severity": "high",
     "query": "access control least privilege role based",
     "any_of": ["least privilege", "role-based access", "role based access", "need-to-know", "need to know"]},
    {"id": "ACC-02", "title": "Periodic access recertification", "severity": "high",
     "query": "access review recertification periodic",
     "any_of": ["access review", "recertif", "review of access", "access rights shall be reviewed"],
     "needs_owner": true, "needs_frequency": true},
    {"id": "ACC-03", "title": "Multi-factor authentication", "severity": "high",
     "query": "multi-factor authentication privileged remote access",
     "any_of": ["multi-factor", "multifactor", "two-factor", "mfa"],
     "also_expect": [{"label": "scope (privileged or remote access)", "any_of": ["privileged", "remote", "administrator", "admin"]}]},
    {"id": "DAT-01", "title": "Encryption of data at rest and in transit", "severity": "critical",
     "query": "encryption data at rest in transit",
     "any_of": ["encrypt"],
     "also_expect": [{"label": "data at rest", "any_of": ["at rest"]}, {"label": "data in transit", "any_of": ["in transit", "tls"]}]},
    {"id": "DAT-02", "title": "Data retention and secure disposal", "severity": "high",
     "query": "data retention period disposal deletion",
     "any_of": ["retention", "retained", "dispos", "secure deletion", "destroyed"],
     "needs_timebound": true,
     "also_expect": [{"label": "secure disposal", "any_of": ["dispos", "destroy", "delet", "purg"]}]},
    {"id": "DAT-03", "title": "Customer privacy and consent", "severity": "medium",
     "query": "customer personal data privacy consent",
     "any_of": ["consent", "personal data", "data protection", "privacy"]},
    {"id": "INC-01", "title": "Incident response and breach notification", "severity": "critical",
     "query": "security incident response breach notification regulator",
     "any_of": ["incident response", "security incident", "breach notification", "notify the regulator"],
     "needs_owner": true, "needs_timebound": true},
    {"id": "BCP-01", "title": "Business continuity and disaster recovery testing", "severity": "high",
     "query": "business continuity disaster recovery testing",
     "any_of": ["business continuity", "disaster recovery", "recovery time objective", "rto"],
     "needs_frequency": true},
    {"id": "FIN-01", "title": "KYC / customer due diligence", "severity": "critical",
     "query": "know your customer due diligence identification",
     "any_of": ["know your customer", "kyc", "customer due diligence", "customer identification"],
     "needs_owner": true},
    {"id": "FIN-02", "title": "Enhanced due diligence for PEPs and high-risk customers", "severity": "high",
     "query": "politically exposed persons enhanced due diligence high-risk",
     "any_of": ["politically exposed", "pep", "enhanced due diligence", "high-risk customer"]},
    {"id": "FIN-03", "title": "Sanctions and watchlist screening", "severity": "critical",
     "query": "sanctions watchlist screening onboarding ongoing",
     "any_of": ["sanction", "watchlist", "watch list", "ofac"],
     "needs_frequency": true},
    {"id": "FIN-04", "title": "Transaction monitoring and suspicious activity reporting", "severity": "critical",
     "query": "transaction monitoring suspicious activity report filing",
     "any_of": ["transaction monitoring", "suspicious transaction", "suspicious activity", "unusual transaction"],
     "needs_owner": true, "needs_timebound": true},
    {"id": "REC-01", "title": "Tamper-evident audit trail", "severity": "high",
     "query": "audit trail log tamper immutable",
     "any_of": ["audit trail", "audit log", "immutable", "tamper"]},
    {"id": "VEN-01", "title": "Third-party and outsourcing risk", "severity": "high",
     "query": "third party vendor outsourcing risk assessment",
     "any_of": ["third-party", "third party", "vendor", "outsourc", "service provider"],
     "needs_owner": true, "needs_frequency": true},
    {"id": "TRN-01", "title": "Staff training and awareness", "severity": "medium",
     "query": "staff training awareness compliance",
     "any_of": ["training", "awareness"],
     "needs_frequency": true}
  ]
}
